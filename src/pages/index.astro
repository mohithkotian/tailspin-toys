---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section
      aria-label="Game filters"
      class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-4 shadow-lg"
      data-testid="game-filters"
    >
      <div class="flex flex-col gap-4 md:flex-row md:items-end">
        <div class="flex-1">
          <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Filter by category
          </label>
          <select
            id="category-filter"
            data-testid="category-filter"
            multiple
            size={Math.min(categories.length || 1, 6)}
            aria-label="Filter games by category"
            class="h-32 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            {categories.map((category) => (
              <option value={category.name} selected={false}>{category.name}</option>
            ))}
          </select>
        </div>

        <div class="flex-1">
          <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">
            Filter by publisher
          </label>
          <select
            id="publisher-filter"
            data-testid="publisher-filter"
            aria-label="Filter games by publisher"
            class="h-12 w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            <option value="all">All publishers</option>
            {publishers.map((publisher) => (
              <option value={publisher.name}>{publisher.name}</option>
            ))}
          </select>
        </div>

        <button
          type="button"
          data-testid="clear-filters"
          class="h-12 rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-sm font-medium text-slate-100 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          Clear filters
        </button>
      </div>

      <p class="mt-3 text-sm text-slate-300" data-testid="filtered-games-count">
        Showing {games.length} game{games.length === 1 ? '' : 's'}
      </p>
    </section>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div
            class="mt-6 hidden rounded-xl border border-slate-700 bg-slate-800/60 p-4 text-slate-200"
            data-testid="no-results"
            role="status"
            aria-live="polite"
          >
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
    const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
    const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const noResults = document.querySelector<HTMLElement>('[data-testid="no-results"]');
    const summary = document.querySelector<HTMLElement>('[data-testid="filtered-games-count"]');

    function updateVisibleGames() {
      if (!categoryFilter || !publisherFilter || !summary) {
        return;
      }

      const selectedCategories = new Set(
        Array.from(categoryFilter.selectedOptions).map((option: HTMLOptionElement) => option.value),
      );
      const selectedPublisher = publisherFilter.value;
      let visibleCount = 0;

      for (const card of cards) {
        const cardCategory = card.getAttribute('data-game-category') ?? '';
        const cardPublisher = card.getAttribute('data-game-publisher') ?? '';
        const matchesCategory = selectedCategories.size === 0 || selectedCategories.has(cardCategory);
        const matchesPublisher = selectedPublisher === 'all' || cardPublisher === selectedPublisher;
        const shouldShow = matchesCategory && matchesPublisher;

        card.hidden = !shouldShow;

        if (shouldShow) {
          visibleCount += 1;
        }
      }

      summary.textContent = `Showing ${visibleCount} game${visibleCount === 1 ? '' : 's'}`;

      if (noResults) {
        noResults.hidden = visibleCount !== 0;
      }
    }

    categoryFilter?.addEventListener('change', updateVisibleGames);
    publisherFilter?.addEventListener('change', updateVisibleGames);
    clearFiltersButton?.addEventListener('click', () => {
      if (categoryFilter) {
        categoryFilter.selectedIndex = -1;
      }

      if (publisherFilter) {
        publisherFilter.value = 'all';
      }

      updateVisibleGames();
    });

    updateVisibleGames();
  </script>
</Layout>
